#!/usr/bin/env bash
# capacity-tmuxer — watch whitelisted tmux sessions running the Codex CLI for the
# "Selected model is at capacity" stall and auto-resubmit so the agent continues.
#
# Freshness (send only when the message is *fresh and last*) is decided from three
# scroll-independent facts, not from the message string itself:
#   1. position — only the bottom slice of the live frame counts (a message you
#      scrolled past is not in it);
#   2. idle     — the busy indicator ("esc to interrupt") must be absent, proving
#      Codex actually stopped rather than still working;
#   3. backoff  — while stalled, resend on an exponential backoff (BACKOFF_START..
#      BACKOFF_MAX); the timer resets once Codex is seen working again, so a fresh
#      stall starts cheap while a persistent one keeps retrying at a bounded rate.
#
# Usage: capacity-tmuxer [--status-pane|-s] [SESSION ...]
#   Sessions are the whitelist. With none given, falls back to $WATCH_SESSIONS
#   (space/comma separated). At least one session is required.
#
#   Default mode watches the sessions and auto-resubmits on capacity stalls.
#   --status-pane instead renders a live one-screen readout of every watched
#   pane's state (WORKING / IDLE / CAPACITY) — run it in a split you keep at the
#   bottom to get the "pinned status bar" Codex's inline TUI doesn't provide.
#
# Tunables (env vars, with defaults):
#   POLL=15            seconds between scans (watch mode)
#   STATUS_POLL=2      seconds between refreshes (--status-pane mode)
#   WINDOW=20          bottom lines that count as "current/last"
#   CAP_RE='Selected model is at capacity'   capacity message to match (grep -i)
#   BUSY_RE='esc to interrupt'               present == Codex is working
#   BACKOFF_START=30   first wait after a send (s)
#   BACKOFF_MAX=900    backoff ceiling (s)
#   SEND_TEXT=continue text submitted to resume the agent
#   GUARD_COMPOSER=1   only send when the input box is the empty (dim) placeholder,
#                      so a half-typed prompt is never clobbered (fail-safe: skip)
set -uo pipefail

case "${1:-}" in
  -h|--help)
    sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

# ---- config (env-overridable) ----------------------------------------------
POLL=${POLL:-15}
STATUS_POLL=${STATUS_POLL:-2}
WINDOW=${WINDOW:-20}
CAP_RE=${CAP_RE:-'Selected model is at capacity'}
BUSY_RE=${BUSY_RE:-'esc to interrupt'}
BACKOFF_START=${BACKOFF_START:-30}
BACKOFF_MAX=${BACKOFF_MAX:-900}
SEND_TEXT=${SEND_TEXT:-continue}
GUARD_COMPOSER=${GUARD_COMPOSER:-1}
# -----------------------------------------------------------------------------

command -v tmux >/dev/null 2>&1 || { echo "error: tmux not found in PATH" >&2; exit 127; }

# mode flag (must precede the session list)
STATUS_MODE=0
case "${1:-}" in
  --status-pane|-s) STATUS_MODE=1; shift ;;
esac

# whitelist from args, else $WATCH_SESSIONS (comma/space separated)
WHITELIST=("$@")
if [ "${#WHITELIST[@]}" -eq 0 ]; then
  IFS=', ' read -r -a WHITELIST <<<"${WATCH_SESSIONS:-}"
fi
if [ "${#WHITELIST[@]}" -eq 0 ]; then
  echo "error: no sessions given (pass as args or set WATCH_SESSIONS)" >&2
  echo "try: capacity-tmuxer --help" >&2
  exit 2
fi
now() { date +%s; }

# Per-pane state without associative arrays, so this runs on any bash (including
# the older one macOS ships). Keys are pane targets like "43:0.0"; sanitize to a
# valid var name.
_key() { printf '%s' "${1//[!a-zA-Z0-9]/_}"; }
sget() { local v="$1_$(_key "$2")"; printf '%s' "${!v:-$3}"; }   # prefix key default
sset() { printf -v "$1_$(_key "$2")" '%s' "$3"; }                # prefix key value

panes_of() { # session -> one "session:window.pane" target per line
  tmux list-panes -s -t "$1" -F '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null
}

# pane -> "STATE|detail"; STATE in WORKING | CAPACITY | IDLE | GONE
classify() {
  local pane="$1" slice line
  slice=$(tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n "$WINDOW") || { printf 'GONE|'; return; }
  if grep -qi "$BUSY_RE" <<<"$slice"; then
    line=$(grep -i -m1 "$BUSY_RE" <<<"$slice" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
    printf 'WORKING|%s' "$line"
  elif grep -qi "$CAP_RE" <<<"$slice"; then
    printf 'CAPACITY|at capacity — waiting to resubmit'
  else
    printf 'IDLE|'
  fi
}

# Live one-screen readout of every watched pane. Runs until interrupted.
run_status_pane() {
  local sess pane rec state detail
  printf '\033[?25l'                                   # hide cursor
  trap 'printf "\033[?25h\n"' EXIT                     # always restore cursor
  trap 'exit 0' INT TERM                               # ...and actually exit on signal
  while true; do
    printf '\033[H\033[2J'                             # home + clear
    printf 'capacity-tmuxer  %s   sessions: %s   (refresh %ss)\n\n' \
      "$(date '+%H:%M:%S')" "${WHITELIST[*]}" "$STATUS_POLL"
    printf '%-18s  %-9s  %s\n' PANE STATE DETAIL
    printf '%-18s  %-9s  %s\n' '------' '-----' '------'
    for sess in "${WHITELIST[@]}"; do
      while IFS= read -r pane; do
        [ -n "$pane" ] || continue
        rec=$(classify "$pane"); state=${rec%%|*}; detail=${rec#*|}
        printf '%-18s  %-9s  %s\n' "$pane" "$state" "$detail"
      done < <(panes_of "$sess")
    done
    sleep "$STATUS_POLL"
  done
}

PROMPT_GLYPH_NEW=$'\xc2\xbb'   # current Codex composer prompt: »
PROMPT_GLYPH_OLD=$'\xe2\x80\xba' # older Codex composer prompt: ›
DIM=$'\x1b[2m'                 # SGR faint — how Codex renders the empty placeholder

# 0 == composer is the empty (dim placeholder) box and is safe to type into.
# Fail-safe: any parse failure or visible non-dim text returns non-zero (skip).
# Empty shape (current Codex): » + reset/bg SGRs + spaces + \x1b[2m<placeholder>
composer_is_empty() {
  local pane="$1" frame line after code
  frame=$(tmux capture-pane -e -p -t "$pane" 2>/dev/null) || return 1
  line=$(printf '%s\n' "$frame" | LC_ALL=C grep -aE "$PROMPT_GLYPH_NEW|$PROMPT_GLYPH_OLD" | tail -n1)
  [ -n "$line" ] || return 1                       # no composer found -> skip
  case "$line" in
    *"$PROMPT_GLYPH_NEW"*) after=${line#*"$PROMPT_GLYPH_NEW"} ;;
    *)                     after=${line#*"$PROMPT_GLYPH_OLD"} ;;
  esac
  # Peel leading spaces and non-dim SGRs. First content style \x1b[2m == placeholder.
  # (Must match exact faint SGR — not the "2" inside 48;2;r;g;b background colour.)
  while [ -n "$after" ]; do
    after="${after#"${after%%[![:space:]]*}"}"
    case "$after" in
      "$DIM"*) return 0 ;;
      $'\x1b['*)
        code=${after%%m*}
        [ "$code" = "$after" ] && return 1          # malformed CSI -> skip
        after=${after#"$code"m}
        ;;
      '') return 0 ;;                              # nothing left
      *) return 1 ;;                               # typed / non-dim text
    esac
  done
  return 0
}

send_continue() {
  local pane="$1"
  tmux send-keys -t "$pane" "$SEND_TEXT"
  sleep 0.4                     # let the composer settle before submit
  tmux send-keys -t "$pane" Enter
}

if [ "$STATUS_MODE" = 1 ]; then
  run_status_pane
  exit 0
fi

printf 'watching sessions: %s  (poll %ss, cap_re=%q)\n' "${WHITELIST[*]}" "$POLL" "$CAP_RE"

while true; do
  for sess in "${WHITELIST[@]}"; do
    # all panes in this session, across its windows
    while IFS= read -r pane; do
      [ -n "$pane" ] || continue
      slice=$(tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n "$WINDOW") || continue

      if grep -qi "$BUSY_RE" <<<"$slice"; then
        sset backoff "$pane" "$BACKOFF_START"   # recovered -> next stall starts fresh
        continue
      fi

      if grep -qi "$CAP_RE" <<<"$slice"; then
        backoff_v=$(sget backoff "$pane" "$BACKOFF_START")
        last_v=$(sget last_ts "$pane" 0)
        if [ $(( $(now) - last_v )) -ge "$backoff_v" ]; then
          if [ "$GUARD_COMPOSER" = 1 ] && ! composer_is_empty "$pane"; then
            printf '%s  skip %s: composer not empty (guard)\n' "$(date +%T)" "$pane"
            continue
          fi
          send_continue "$pane"
          sset last_ts "$pane" "$(now)"
          backoff_v=$(( backoff_v * 2 ))
          [ "$backoff_v" -gt "$BACKOFF_MAX" ] && backoff_v=$BACKOFF_MAX
          sset backoff "$pane" "$backoff_v"
          printf '%s  sent "%s" -> %s (next backoff %ss)\n' \
            "$(date +%T)" "$SEND_TEXT" "$pane" "$backoff_v"
        fi
      fi
    done < <(panes_of "$sess")
  done
  sleep "$POLL"
done
